					"params": {
						"_hostAddress": "L'indirizzo del wallet configurato sull'Agent VPS.",
						"_hostname": "Nome identificativo della macchina (es. \"srv-prod-ssh-01\").",
						"_ipAddress": "Indirizzo IP del server."
					}
				},
				"renounceOwnership()": {
					"details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
				},
				"transferOwnership(address)": {
					"details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
				},
				"verifyLeafProof(string,bytes32,bytes32[])": {
					"params": {
						"_batchId": "ID del batch di riferimento.",
						"_leaf": "Hash (foglia) del log specifico.",
						"_proof": "Percorso di Merkle generato per la foglia."
					},
					"returns": {
						"isValid": "True se il log è matematicamente integro e certificato.",
						"recorder": "Indirizzo del server VPS che ha effettuato l'ancoraggio.",
						"timestamp": "Timestamp del blocco in cui la root è stata ancorata."
					}
				}
			},
			"title": "LogNotary",
			"version": 1
		},
		"userdoc": {
			"kind": "user",
			"methods": {
				"getAllHosts()": {
					"notice": "Restituisce la lista completa degli indirizzi degli host per le dashboard di visualizzazione."
				},
				"getHostCount()": {
					"notice": "Restituisce il numero totale di server censiti."
				},
				"offboardHost(address)": {
					"notice": "Disattiva un server compromesso o dismesso (offboarding)."
				},
				"reactivateHost(address)": {
					"notice": "Riattiva un host precedentemente disattivato."
				},
				"recordBatchRoot(string,bytes32,uint256)": {
					"notice": "Ancola la Merkle Root calcolata dall'Agent VPS su L2."
				},
				"registerHost(address,string,string)": {
					"notice": "Registra un nuovo server Linux/VPS autorizzato ad ancorare radici di Merkle."
				},
				"verifyLeafProof(string,bytes32,bytes32[])": {
					"notice": "Verifica matematicamente l'inclusione probatoria di un singolo log all'interno di un batch."
				}
